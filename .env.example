# Copied to .env by ./setup.sh, which fills the secrets automatically.

# --- Secrets (generated) ------------------------------------------------------
VNC_PW=
MCP_AUTH_TOKEN=

# --- Images -------------------------------------------------------------------
# Check https://hub.docker.com/r/kasmweb/ubuntu-noble-desktop/tags for the latest.
KASM_TAG=1.18.0
NODE_MAJOR=22

# --- Networking ---------------------------------------------------------------
# 127.0.0.1 is correct for Codespaces (port forwarding reaches localhost).
# Use 0.0.0.0 only on a firewalled VM.
BIND_ADDR=127.0.0.1
DOCKER_NETWORK=kasm-mcp-net
PORTAL_PORT=3000
LINUX_PORT=6901
WINDOWS_PORT=6902
MACOS_PORT=6903
MCP_PORT=8811

# --- Resources (per desktop) --------------------------------------------------
DESKTOP_SHM_SIZE=1gb
DESKTOP_CPUS=2
DESKTOP_MEMORY=4g

# --- Misc ---------------------------------------------------------------------
TZ=Africa/Cairo
LOG_LEVEL=INFO
MCP_MAX_OUTPUT_CHARS=20000
