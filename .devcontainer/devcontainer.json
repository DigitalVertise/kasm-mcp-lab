{
  "name": "Kasm Multi-OS Desktop Lab + MCP",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": { "moby": true, "dockerDashComposeVersion": "v2" },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "hostRequirements": { "cpus": 8, "memory": "32gb", "storage": "64gb" },
  "forwardPorts": [3000, 6901, 6902, 6903, 8811],
  "portsAttributes": {
    "3000": { "label": "Portal", "protocol": "http", "onAutoForward": "openBrowserOnce" },
    "6901": { "label": "Linux desktop", "protocol": "https", "onAutoForward": "silent" },
    "6902": { "label": "Windows app sandbox", "protocol": "https", "onAutoForward": "silent" },
    "6903": { "label": "macOS-style desktop", "protocol": "https", "onAutoForward": "silent" },
    "8811": { "label": "MCP server", "protocol": "http", "onAutoForward": "silent" }
  },
  "postCreateCommand": "chmod +x setup.sh && echo 'Run ./setup.sh to build and start the lab.'",
  "customizations": {
    "vscode": { "extensions": ["ms-azuretools.vscode-docker", "ms-python.python"] }
  }
}
